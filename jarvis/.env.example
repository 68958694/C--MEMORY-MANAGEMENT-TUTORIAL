# Copy this file to ".env" in the folder you run JARVIS from (or to ~/.jarvis/.env)
# and fill in your values. The .env file is git-ignored: never share or commit it.

# --- AI brain (required for conversation, coding, finding clients) -------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here
# Optional: use Claude instead (https://console.anthropic.com)
# ANTHROPIC_API_KEY=
# JARVIS_PROVIDER=claude

# --- You and your business --------------------------------------------------
JARVIS_USER_TITLE=sir
JARVIS_CITY=
# What you sell and who your ideal clients are (or just tell JARVIS out loud).
JARVIS_BUSINESS=

# --- Phone calls and texts (optional, https://twilio.com) ---------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
JARVIS_MY_PHONE=

# --- Updates ----------------------------------------------------------------------
# Daily briefing time (24h) or "off"; how to deliver it: voice, sms, call (comma-separated).
JARVIS_BRIEFING_TIME=08:30
JARVIS_BRIEFING_BY=voice
# Remind you this many minutes before each Google Calendar meeting (0 = off).
JARVIS_REMINDER_MINUTES=10
